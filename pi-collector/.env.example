# Runtime secrets come from the environment or a local .env file.
# Never commit real values. The collector is read-only against PI Web API.

# --- PI Web API (read-only) ---
# Required for live operations; use the instance-specific runtime value.
# Synthetic example only:
PI_WEB_API_BASE_URL=https://pi.example.test/piwebapi
PI_USERNAME=DOMAIN\user
PI_PASSWORD=<password>
# Optional: if a bearer token is available instead of Basic auth
PI_TOKEN=
PI_TIMEOUT_SECONDS=30
PI_RATE_LIMIT_SECONDS=1
PI_MAX_RESPONSE_BYTES=1048576
PI_VERIFY_TLS=1

# --- Safety (bulk backfill guardrails) ---
# Maximum API requests per backfill session (circuit breaker)
PI_MAX_REQUESTS_PER_SESSION=5000
# Split long time ranges into N-day windows (smaller = safer, more requests)
PI_BACKFILL_CHUNK_DAYS=7
# Abort after this many consecutive errors (PI may be down or blocking)
PI_MAX_CONSECUTIVE_ERRORS=10
# Extra pause between attributes (seconds) to protect PI server
PI_PAUSE_BETWEEN_ATTRIBUTES=2.0
# Off-hours window: backfill-recorded only runs during these hours (local time)
PI_OFF_HOURS_START=22
PI_OFF_HOURS_END=6
# Allow backfill on Saturday/Sunday anytime
PI_OFF_HOURS_WEEKEND=1
# Expected snapshot cycle in seconds — drives the /schedule countdown in the
# web UI. Align with your scheduler (cron */5 or picollector run --interval-seconds)
PI_SNAPSHOT_INTERVAL_SECONDS=300

# --- Postgres (collector local DB, TimescaleDB recommended) ---
# Note: postgresql+psycopg uses psycopg3 (the installed driver)
DATABASE_URL=postgresql+psycopg://picollector:picollector@localhost:5433/picollector
DATABASE_ECHO=0

# --- Registry ---
# Path to the complete BSR1 attribute registry from pi-knowledge (source of truth).
# The file retains all discovered attributes; the collector activates only
# entries with status=verified and stream_status=ok.
# This file defines which attributes to collect.
PI_REGISTRY_PATH=../pi-knowledge/mappings/bsr1-parameters.yaml
