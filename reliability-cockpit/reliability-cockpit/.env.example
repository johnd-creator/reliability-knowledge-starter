# Runtime secrets come from the environment or a local .env file.
# Never commit real values. The sidecar is read-only against the collector API.

# --- Data source ---
# Base URL for the maximo-collector API (the only remote dependency).
MAXIMO_COLLECTOR_API_BASE=http://127.0.0.1:8002

# --- Database ---
DATABASE_URL=postgresql://cockpit:cockpit@localhost:5432/cockpit
DATABASE_ECHO=0

# --- App defaults ---
RATE_LIMIT_SECONDS=0.5
