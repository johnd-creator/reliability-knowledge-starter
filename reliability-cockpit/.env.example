# Runtime configuration comes from the environment or a local .env file.
# Never commit real values. Normal Cockpit operation reads collector APIs only.

# --- Collector APIs (host-local defaults; use compose service names in managed mode) ---
MAXIMO_COLLECTOR_API_BASE=http://127.0.0.1:8002
PI_COLLECTOR_API_BASE=http://127.0.0.1:8001
CEMS_COLLECTOR_API_BASE=http://127.0.0.1:8003
COLLECTOR_TIMEOUT_SECONDS=60

# --- Postgres (cockpit local DB, not production) ---
DATABASE_URL=postgresql://cockpit:cockpit@localhost:5432/cockpit
DATABASE_ECHO=0

# Maximo OSLC source configuration belongs only to maximo-collector. The legacy
# read-only adapter remains for isolated compatibility tests and is not used by
# the Cockpit CLI/worker.
