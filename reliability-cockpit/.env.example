# Runtime secrets come from the environment or a local .env file.
# Never commit real values. The sidecar is read-only against Maximo.

# --- Maximo OSLC (read-only) ---
MAXIMO_BASE_URL=http://maximo.plnindonesiapower.co.id/maximo
MAXIMO_OSLC_ROOT=/oslc/os
MAXIMO_OAS_PATH=/oslc/oas
MAXIMO_SITE_ID=BSR
MAXIMO_ORG_ID=IP
# bearer = read-only token; none = public/documentation-only
MAXIMO_AUTH_MODE=bearer
MAXIMO_READ_ONLY_TOKEN=<READ_ONLY_TOKEN>
# Optional session cookie supplied out-of-band (manual login); do not persist.
MAXIMO_SESSION_COOKIE=<SESSION_COOKIE>
MAXIMO_TIMEOUT_SECONDS=30
MAXIMO_RATE_LIMIT_SECONDS=1
MAXIMO_PAGE_SIZE=100
MAXIMO_MAX_RESPONSE_BYTES=1048576

# --- Postgres (cockpit local DB, not production) ---
DATABASE_URL=postgresql://cockpit:cockpit@localhost:5432/cockpit
DATABASE_ECHO=0

# --- PI Web API (not yet wired) ---
PI_BASE_URL=https://pi.plnindonesiapower.co.id/piwebapi