{
  "$defs": {
    "DigitalState": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "is_system": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issystem"
        }
      },
      "title": "DigitalState",
      "type": "object"
    },
    "EvidenceAttributeSources": {
      "additionalProperties": false,
      "properties": {
        "pi": {
          "$ref": "#/$defs/PiAttributeLineage"
        }
      },
      "required": [
        "pi"
      ],
      "title": "EvidenceAttributeSources",
      "type": "object"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_boundary": {
          "const": "GOVERNED_PI_SOURCE",
          "default": "GOVERNED_PI_SOURCE",
          "title": "Source Boundary",
          "type": "string"
        },
        "selection_evidence_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Selection Evidence Ref",
          "type": "string"
        },
        "selection_approved_by": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Selection Approved By",
          "type": "string"
        },
        "selection_approved_at": {
          "format": "date-time",
          "title": "Selection Approved At",
          "type": "string",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "selection_evidence_ref",
        "selection_approved_by",
        "selection_approved_at"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "PiAttributeLineage": {
      "additionalProperties": false,
      "properties": {
        "pi_source_id": {
          "const": "CENTRAL_PI",
          "title": "Pi Source Id",
          "type": "string"
        },
        "af_server_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Server Ref",
          "type": "string"
        },
        "af_database_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Database Ref",
          "type": "string"
        },
        "af_element_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Element Ref",
          "type": "string"
        },
        "mapping_role": {
          "const": "PRIMARY_EQUIPMENT",
          "title": "Mapping Role",
          "type": "string"
        },
        "mapping_status": {
          "const": "VERIFIED",
          "title": "Mapping Status",
          "type": "string"
        },
        "attribute_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Attribute Ref",
          "type": "string"
        },
        "attribute_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute Name"
        }
      },
      "required": [
        "pi_source_id",
        "af_server_ref",
        "af_database_ref",
        "af_element_ref",
        "mapping_role",
        "mapping_status",
        "attribute_ref"
      ],
      "title": "PiAttributeLineage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "canonical_asset_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Canonical Asset Id",
      "type": "string"
    },
    "mapping_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Mapping Id",
      "type": "string"
    },
    "signal_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Signal Id",
      "type": "string"
    },
    "semantic_name": {
      "pattern": "^[a-z][a-z0-9_]{0,79}$",
      "title": "Semantic Name",
      "type": "string"
    },
    "sources": {
      "$ref": "#/$defs/EvidenceAttributeSources"
    },
    "value_type": {
      "enum": [
        "NUMERIC",
        "TEXT",
        "DIGITAL_STATE",
        "BOOLEAN",
        "NULL"
      ],
      "title": "Value Type",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/DigitalState"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    },
    "source_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Timestamp"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "quality_good": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality Good"
    },
    "quality_questionable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality Questionable"
    },
    "quality_substituted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality Substituted"
    },
    "quality_annotated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality Annotated"
    },
    "evidence_status": {
      "enum": [
        "EVIDENCE_AVAILABLE",
        "BAD_QUALITY",
        "UNKNOWN_VALUE",
        "UNKNOWN_QUALITY"
      ],
      "title": "Evidence Status",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/EvidenceProvenance"
    }
  },
  "required": [
    "canonical_asset_id",
    "mapping_id",
    "signal_id",
    "semantic_name",
    "sources",
    "value_type",
    "value",
    "unit",
    "source_timestamp",
    "collected_at",
    "quality_good",
    "quality_questionable",
    "quality_substituted",
    "quality_annotated",
    "evidence_status",
    "provenance"
  ],
  "title": "ConditionEvidence",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliability-data-contracts/schemas/condition-evidence.schema.json",
  "description": "NADI-ING-PI-001A mapping-independent foundation. Synthetic acceptance only; no production mapping or health score.",
  "allOf": [
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "NUMERIC"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "TEXT"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "BOOLEAN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "NULL"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "DIGITAL_STATE"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "quality_good": {
                "const": false
              }
            }
          },
          {
            "properties": {
              "quality_questionable": {
                "const": true
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "evidence_status": {
            "const": "BAD_QUALITY"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "value": {
              "type": "null"
            }
          }
        },
        "then": {
          "properties": {
            "evidence_status": {
              "const": "UNKNOWN_VALUE"
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "quality_good": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_status": {
                "const": "UNKNOWN_QUALITY"
              }
            }
          },
          "else": {
            "properties": {
              "evidence_status": {
                "const": "EVIDENCE_AVAILABLE"
              }
            }
          }
        }
      }
    }
  ]
}
