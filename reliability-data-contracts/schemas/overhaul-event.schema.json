{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliability-data-contracts/schemas/overhaul-event.schema.json",
  "title": "NADI Overhaul Event v1",
  "type": "object",
  "required": ["canonical_id", "contract_version", "provenance", "relationship_evidence"],
  "properties": {
    "canonical_id": {"type": "string"}, "contract_version": {"const": "1.0"}, "source_record_id": {"type": ["string", "null"]}, "source_number": {"type": ["string", "null"]}, "lifecycle_status": {"type": ["string", "null"]}, "workorder_ref": {"type": ["string", "null"]}, "asset_ref": {"type": ["string", "null"]}, "site_code": {"type": ["string", "null"]}, "organization_code": {"type": ["string", "null"]}, "planned_start_at": {"type": ["string", "null"], "format": "date-time"}, "planned_finish_at": {"type": ["string", "null"], "format": "date-time"}, "actual_start_at": {"type": ["string", "null"], "format": "date-time"}, "actual_finish_at": {"type": ["string", "null"], "format": "date-time"}, "progress": {"type": ["number", "integer", "string", "null"]}, "source_created_at": {"type": ["string", "null"], "format": "date-time"}, "source_updated_at": {"type": ["string", "null"], "format": "date-time"}, "unresolved_source_attributes": {"type": "object", "properties": {"inspection_number": {"type": ["string", "null"]}, "performance_test": {"type": ["string", "number", "boolean", "null"]}}, "additionalProperties": false}, "provenance": {"$ref": "#/$defs/provenance"}, "relationship_evidence": {"$ref": "#/$defs/relationshipEvidence"}, "sources": {"$ref": "#/$defs/sources"}
  },
  "$defs": {
    "provenance": {"type": "object", "required": ["source_system", "source_object", "source_record_id"], "properties": {"source_system": {"const": "MAXIMO"}, "source_application": {"type": ["string", "null"]}, "source_object": {"type": "string"}, "source_record_id": {"type": "string"}, "source_number": {"type": ["string", "null"]}, "source_site": {"type": ["string", "null"]}, "source_organization": {"type": ["string", "null"]}, "source_created_at": {"type": ["string", "null"]}, "source_updated_at": {"type": ["string", "null"]}, "ingested_at": {"type": ["string", "null"]}}, "additionalProperties": false},
    "relationshipEvidence": {"type": "object", "additionalProperties": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["DIRECT_VERIFIED", "DERIVED_VERIFIED_PATH", "UNRESOLVED", "DEFERRED"]}, "path": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}}, "additionalProperties": false}},
    "sources": {"type": "object", "properties": {"maximo": {"type": ["object", "null"], "properties": {"object_structure": {"const": "IP_DOM_OH"}, "domid": {"type": ["string", "integer", "null"]}, "domohnum": {"type": ["string", "null"]}, "wonum": {"type": ["string", "null"]}, "inspeksinum": {"type": ["string", "null"]}, "status": {"type": ["string", "null"]}, "siteid": {"type": ["string", "null"]}, "orgid": {"type": ["string", "null"]}, "tgl_mulai": {"type": ["string", "null"]}, "tgl_selesai": {"type": ["string", "null"]}, "tgl_actual_mulai": {"type": ["string", "null"]}, "tgl_actual_selesai": {"type": ["string", "null"]}, "changedate": {"type": ["string", "null"]}, "createdate": {"type": ["string", "null"]}, "progress": {"type": ["string", "number", "null"]}, "perfomance_test": {"type": ["string", "number", "boolean", "null"]}}, "additionalProperties": false}}, "additionalProperties": false}
  }
}
