{
  "$defs": {
    "CaseStatus": {
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "REJECTED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "Category": {
      "enum": [
        "INVESTIGATION",
        "MAINTENANCE",
        "CONDITION"
      ],
      "title": "Category",
      "type": "string"
    },
    "ConditionEvidence": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "canonical_asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Asset Id",
          "type": "string"
        },
        "mapping_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mapping Id",
          "type": "string"
        },
        "signal_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Signal Id",
          "type": "string"
        },
        "semantic_name": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Semantic Name",
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/EvidenceAttributeSources"
        },
        "value_type": {
          "enum": [
            "NUMERIC",
            "TEXT",
            "DIGITAL_STATE",
            "BOOLEAN",
            "NULL"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/DigitalState"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Timestamp"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "quality_good": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Good"
        },
        "quality_questionable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Questionable"
        },
        "quality_substituted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Substituted"
        },
        "quality_annotated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Annotated"
        },
        "evidence_status": {
          "enum": [
            "EVIDENCE_AVAILABLE",
            "BAD_QUALITY",
            "UNKNOWN_VALUE",
            "UNKNOWN_QUALITY"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/EvidenceProvenance"
        }
      },
      "required": [
        "canonical_asset_id",
        "mapping_id",
        "signal_id",
        "semantic_name",
        "sources",
        "value_type",
        "value",
        "unit",
        "source_timestamp",
        "collected_at",
        "quality_good",
        "quality_questionable",
        "quality_substituted",
        "quality_annotated",
        "evidence_status",
        "provenance"
      ],
      "title": "ConditionEvidence",
      "type": "object"
    },
    "DigitalState": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "is_system": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is System"
        }
      },
      "title": "DigitalState",
      "type": "object"
    },
    "EvidenceAttributeSources": {
      "additionalProperties": false,
      "properties": {
        "pi": {
          "$ref": "#/$defs/PiAttributeLineage"
        }
      },
      "required": [
        "pi"
      ],
      "title": "EvidenceAttributeSources",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "ASSET",
        "MAINTENANCE",
        "WORK_ORDER",
        "FMEA",
        "RCFA",
        "CONDITION",
        "DATA_TRUST"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_boundary": {
          "const": "GOVERNED_PI_SOURCE",
          "default": "GOVERNED_PI_SOURCE",
          "title": "Source Boundary",
          "type": "string"
        },
        "selection_evidence_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Selection Evidence Ref",
          "type": "string"
        },
        "selection_approved_by": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Selection Approved By",
          "type": "string"
        },
        "selection_approved_at": {
          "format": "date-time",
          "title": "Selection Approved At",
          "type": "string"
        }
      },
      "required": [
        "selection_evidence_ref",
        "selection_approved_by",
        "selection_approved_at"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "canonical_asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "source": {
          "enum": [
            "CANONICAL_MART",
            "NADI_CONDITION",
            "NADI_DATA_TRUST"
          ],
          "title": "Source",
          "type": "string"
        },
        "mode": {
          "enum": [
            "LIVE_REFERENCE",
            "FROZEN_SNAPSHOT"
          ],
          "title": "Mode",
          "type": "string"
        },
        "stable_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Stable Version",
          "type": "string"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timestamp"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "linked_at": {
          "format": "date-time",
          "title": "Linked At",
          "type": "string"
        },
        "linked_by": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Linked By",
          "type": "string"
        },
        "identity_status": {
          "const": "VERIFIED",
          "title": "Identity Status",
          "type": "string"
        },
        "signal_approval": {
          "enum": [
            "APPROVED",
            "NOT_APPLICABLE"
          ],
          "title": "Signal Approval",
          "type": "string"
        },
        "freshness": {
          "default": "UNKNOWN",
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "freshness_policy_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness Policy Ref"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "quality_good": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Good"
        },
        "quality_questionable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Questionable"
        },
        "quality_substituted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Substituted"
        },
        "quality_annotated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Annotated"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reference_id",
        "record_id",
        "canonical_asset_id",
        "kind",
        "source",
        "mode",
        "stable_version",
        "observed_at",
        "linked_at",
        "linked_by",
        "identity_status",
        "signal_approval"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "EvidenceSnapshot": {
      "additionalProperties": false,
      "description": "Allowlisted canonical facts, never raw vendor payloads or source URLs.",
      "properties": {
        "label": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability": {
          "default": "UNKNOWN",
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "UNKNOWN"
          ],
          "title": "Availability",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "EvidenceSnapshot",
      "type": "object"
    },
    "Investigation": {
      "additionalProperties": false,
      "properties": {
        "observed_symptoms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Observed Symptoms",
          "type": "array"
        },
        "operating_context": {
          "default": "",
          "maxLength": 6000,
          "title": "Operating Context",
          "type": "string"
        },
        "hypotheses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Hypotheses",
          "type": "array"
        },
        "observations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Observations",
          "type": "array"
        },
        "open_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Open Questions",
          "type": "array"
        },
        "proposed_next_checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Proposed Next Checks",
          "type": "array"
        }
      },
      "title": "Investigation",
      "type": "object"
    },
    "InvestigationNote": {
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "text",
        "actor",
        "created_at"
      ],
      "title": "InvestigationNote",
      "type": "object"
    },
    "PiAttributeLineage": {
      "additionalProperties": false,
      "properties": {
        "pi_source_id": {
          "const": "CENTRAL_PI",
          "title": "Pi Source Id",
          "type": "string"
        },
        "af_server_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Server Ref",
          "type": "string"
        },
        "af_database_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Database Ref",
          "type": "string"
        },
        "af_element_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Element Ref",
          "type": "string"
        },
        "mapping_role": {
          "const": "PRIMARY_EQUIPMENT",
          "title": "Mapping Role",
          "type": "string"
        },
        "mapping_status": {
          "const": "VERIFIED",
          "title": "Mapping Status",
          "type": "string"
        },
        "attribute_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Attribute Ref",
          "type": "string"
        },
        "attribute_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute Name"
        }
      },
      "required": [
        "pi_source_id",
        "af_server_ref",
        "af_database_ref",
        "af_element_ref",
        "mapping_role",
        "mapping_status",
        "attribute_ref"
      ],
      "title": "PiAttributeLineage",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "decision",
        "rationale",
        "decided_at"
      ],
      "title": "ReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "problem_statement": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Problem Statement",
      "type": "string"
    },
    "canonical_asset_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Canonical Asset Id",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category",
      "default": "INVESTIGATION"
    },
    "priority": {
      "$ref": "#/$defs/Priority",
      "default": "NORMAL"
    },
    "assigned_engineer": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned Engineer"
    },
    "investigation": {
      "$ref": "#/$defs/Investigation"
    },
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CaseStatus",
      "default": "DRAFT"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "contributors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Contributors",
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "provenance": {
      "const": "HUMAN_ENGINEERING_RECORD",
      "default": "HUMAN_ENGINEERING_RECORD",
      "title": "Provenance",
      "type": "string"
    },
    "notes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InvestigationNote"
      },
      "maxItems": 100,
      "title": "Notes",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "maxItems": 30,
      "title": "Evidence",
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "title",
    "problem_statement",
    "canonical_asset_id",
    "case_id",
    "created_at",
    "updated_at",
    "created_by",
    "revision"
  ],
  "title": "EngineeringCase",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/nadi/engineering-case/1.0"
}
