{
  "$defs": {
    "AttachmentMetadata": {
      "additionalProperties": false,
      "properties": {
        "attachment_ref": {
          "pattern": "^attachment:[A-Za-z0-9_.:-]{1,90}$",
          "title": "Attachment Ref",
          "type": "string"
        },
        "filename": {
          "allOf": [
            {
              "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            },
            {
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            }
          ],
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^/\\\\]+$",
          "title": "Filename",
          "type": "string"
        },
        "content_type": {
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg",
            "text/csv",
            "text/plain"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 10485760,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "status": {
          "const": "METADATA_ONLY_NOT_UPLOADED",
          "default": "METADATA_ONLY_NOT_UPLOADED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "attachment_ref",
        "filename",
        "content_type",
        "size_bytes"
      ],
      "title": "AttachmentMetadata",
      "type": "object"
    },
    "CaptureClock": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "role": {
          "default": "UNSPECIFIED",
          "enum": [
            "ACQUISITION",
            "SAMPLE",
            "ANALYSIS",
            "REPORT",
            "UNSPECIFIED"
          ],
          "title": "Role",
          "type": "string"
        },
        "precision": {
          "default": "UNKNOWN",
          "enum": [
            "DATE",
            "DATETIME",
            "LOCAL_DATETIME",
            "TIME",
            "RAW",
            "UNKNOWN"
          ],
          "title": "Precision",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "source_label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        }
      },
      "title": "CaptureClock",
      "type": "object"
    },
    "CaptureContext": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "role": {
          "enum": [
            "ACQUISITION",
            "OPERATING_CONTEXT",
            "LAB",
            "INSTRUMENT",
            "PROCEDURE",
            "CAMERA",
            "SAMPLE",
            "REPORT"
          ],
          "title": "Role",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "role",
        "label"
      ],
      "title": "CaptureContext",
      "type": "object"
    },
    "CaptureRow": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "row_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Row Id",
          "type": "string"
        },
        "source_label": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Source Label",
          "type": "string"
        },
        "source_field_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field Id"
        },
        "value_region": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}(?::\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Region"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "source_point": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Point"
        },
        "source_axis": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Axis"
        },
        "header_cells": {
          "default": [],
          "items": {
            "maxLength": 40,
            "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}(?::\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6})?$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Header Cells",
          "type": "array"
        },
        "value_origin": {
          "default": "UNKNOWN",
          "enum": [
            "SOURCE_LITERAL",
            "SOURCE_FORMULA_RESULT",
            "MANUAL_REPORTED",
            "UNKNOWN"
          ],
          "title": "Value Origin",
          "type": "string"
        },
        "row_role": {
          "default": "INPUT",
          "enum": [
            "INPUT",
            "REFERENCE",
            "SOURCE_ASSESSMENT"
          ],
          "title": "Row Role",
          "type": "string"
        },
        "contexts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CaptureContext"
          },
          "maxItems": 20,
          "title": "Contexts",
          "type": "array"
        },
        "clock": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureClock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "row_id",
        "source_label"
      ],
      "title": "CaptureRow",
      "type": "object"
    },
    "InputCapture": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "purpose": {
          "const": "PROVISIONAL_INPUT_ONLY",
          "default": "PROVISIONAL_INPUT_ONLY",
          "title": "Purpose",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Source Ref",
          "type": "string"
        },
        "source_asset_label": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Asset Label"
        },
        "source_sheet_label": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sheet Label"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "sheet_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Index"
        },
        "profile_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Profile Version",
          "type": "string"
        },
        "clocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CaptureClock"
          },
          "maxItems": 12,
          "title": "Clocks",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CaptureRow"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "source_ref",
        "profile_id",
        "profile_version",
        "rows"
      ],
      "title": "InputCapture",
      "type": "object"
    },
    "InspectionMethod": {
      "enum": [
        "VIBRATION",
        "IR_THERMOGRAPHY",
        "MCSA",
        "TRIBOLOGY",
        "DGA",
        "OTHER"
      ],
      "title": "InspectionMethod",
      "type": "string"
    },
    "InspectionReview": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "RETURNED",
            "REJECTED"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Rationale",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "decision",
        "rationale",
        "decided_at"
      ],
      "title": "InspectionReview",
      "type": "object"
    },
    "InspectionStatus": {
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "UNDER_REVIEW",
        "IN_REVIEW",
        "APPROVED",
        "RETURNED",
        "REJECTED"
      ],
      "title": "InspectionStatus",
      "type": "string"
    },
    "ManualMeasurement": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Quantity",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "measured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured At"
        },
        "point_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point Ref"
        },
        "quality": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "INSPECTOR_REPORTED"
          ],
          "title": "Quality",
          "type": "string"
        },
        "provenance": {
          "const": "HUMAN_ENTERED_MEASUREMENT",
          "default": "HUMAN_ENTERED_MEASUREMENT",
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "quantity"
      ],
      "title": "ManualMeasurement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "title": "Contract Version",
      "type": "string"
    },
    "record_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/InspectionStatus",
      "default": "DRAFT"
    },
    "created_by": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "contributors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Contributors",
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/InspectionReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_scope": {
      "const": "NADI_RECORD_REVIEW_ONLY",
      "default": "NADI_RECORD_REVIEW_ONLY",
      "title": "Approval Scope",
      "type": "string"
    },
    "canonical_asset_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Canonical Asset Id",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/InspectionMethod"
    },
    "method_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Method Version",
      "type": "string"
    },
    "inspector_ref": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Inspector Ref",
      "type": "string"
    },
    "inspected_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inspected At"
    },
    "operating_context": {
      "anyOf": [
        {
          "maxLength": 6000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operating Context"
    },
    "measurements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ManualMeasurement"
      },
      "maxItems": 100,
      "title": "Measurements",
      "type": "array"
    },
    "observations": {
      "default": [],
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Observations",
      "type": "array"
    },
    "interpretations": {
      "default": [],
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Interpretations",
      "type": "array"
    },
    "attachments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AttachmentMetadata"
      },
      "maxItems": 10,
      "title": "Attachments",
      "type": "array"
    },
    "case_refs": {
      "default": [],
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Case Refs",
      "type": "array"
    },
    "method_extension": {
      "additionalProperties": false,
      "maxProperties": 20,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]{0,79}$": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "Method Extension",
      "type": "object"
    },
    "input_capture": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputCapture"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_started_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Started By"
    },
    "review_started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Started At"
    },
    "provenance": {
      "const": "NADI_MANUAL_INSPECTION",
      "default": "NADI_MANUAL_INSPECTION",
      "title": "Provenance",
      "type": "string"
    },
    "field_approval": {
      "const": "ENGINEER_FIELDS_PENDING",
      "default": "ENGINEER_FIELDS_PENDING",
      "title": "Field Approval",
      "type": "string"
    },
    "assessment": {
      "const": "NOT_ASSESSED",
      "default": "NOT_ASSESSED",
      "title": "Assessment",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "created_by",
    "created_at",
    "updated_at",
    "revision",
    "canonical_asset_id",
    "method",
    "method_version",
    "inspector_ref"
  ],
  "title": "ManualInspection",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadi.example/schema/manual-inspection/v1.2",
  "description": "Human-entered inspection envelope; native1.0/1.1 retained, optional1.2 provisional source input is not Case evidence. Record review does not assert equipment health."
}
