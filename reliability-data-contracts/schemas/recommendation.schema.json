{
  "$defs": {
    "CaseStatus": {
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "REJECTED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "ConditionEvidence": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "canonical_asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Asset Id",
          "type": "string"
        },
        "mapping_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mapping Id",
          "type": "string"
        },
        "signal_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Signal Id",
          "type": "string"
        },
        "semantic_name": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Semantic Name",
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/EvidenceAttributeSources"
        },
        "value_type": {
          "enum": [
            "NUMERIC",
            "TEXT",
            "DIGITAL_STATE",
            "BOOLEAN",
            "NULL"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/DigitalState"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Timestamp"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "quality_good": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Good"
        },
        "quality_questionable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Questionable"
        },
        "quality_substituted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Substituted"
        },
        "quality_annotated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Annotated"
        },
        "evidence_status": {
          "enum": [
            "EVIDENCE_AVAILABLE",
            "BAD_QUALITY",
            "UNKNOWN_VALUE",
            "UNKNOWN_QUALITY"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/EvidenceProvenance"
        }
      },
      "required": [
        "canonical_asset_id",
        "mapping_id",
        "signal_id",
        "semantic_name",
        "sources",
        "value_type",
        "value",
        "unit",
        "source_timestamp",
        "collected_at",
        "quality_good",
        "quality_questionable",
        "quality_substituted",
        "quality_annotated",
        "evidence_status",
        "provenance"
      ],
      "title": "ConditionEvidence",
      "type": "object"
    },
    "DigitalState": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "is_system": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is System"
        }
      },
      "title": "DigitalState",
      "type": "object"
    },
    "EvidenceAttributeSources": {
      "additionalProperties": false,
      "properties": {
        "pi": {
          "$ref": "#/$defs/PiAttributeLineage"
        }
      },
      "required": [
        "pi"
      ],
      "title": "EvidenceAttributeSources",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "ASSET",
        "MAINTENANCE",
        "WORK_ORDER",
        "FMEA",
        "RCFA",
        "CONDITION",
        "DATA_TRUST"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_boundary": {
          "const": "GOVERNED_PI_SOURCE",
          "default": "GOVERNED_PI_SOURCE",
          "title": "Source Boundary",
          "type": "string"
        },
        "selection_evidence_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Selection Evidence Ref",
          "type": "string"
        },
        "selection_approved_by": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Selection Approved By",
          "type": "string"
        },
        "selection_approved_at": {
          "format": "date-time",
          "title": "Selection Approved At",
          "type": "string"
        }
      },
      "required": [
        "selection_evidence_ref",
        "selection_approved_by",
        "selection_approved_at"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "canonical_asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "source": {
          "enum": [
            "CANONICAL_MART",
            "NADI_CONDITION",
            "NADI_DATA_TRUST"
          ],
          "title": "Source",
          "type": "string"
        },
        "mode": {
          "enum": [
            "LIVE_REFERENCE",
            "FROZEN_SNAPSHOT"
          ],
          "title": "Mode",
          "type": "string"
        },
        "stable_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Stable Version",
          "type": "string"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timestamp"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "linked_at": {
          "format": "date-time",
          "title": "Linked At",
          "type": "string"
        },
        "linked_by": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Linked By",
          "type": "string"
        },
        "identity_status": {
          "const": "VERIFIED",
          "title": "Identity Status",
          "type": "string"
        },
        "signal_approval": {
          "enum": [
            "APPROVED",
            "NOT_APPLICABLE"
          ],
          "title": "Signal Approval",
          "type": "string"
        },
        "freshness": {
          "default": "UNKNOWN",
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "freshness_policy_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness Policy Ref"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "quality_good": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Good"
        },
        "quality_questionable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Questionable"
        },
        "quality_substituted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Substituted"
        },
        "quality_annotated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Annotated"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reference_id",
        "record_id",
        "canonical_asset_id",
        "kind",
        "source",
        "mode",
        "stable_version",
        "observed_at",
        "linked_at",
        "linked_by",
        "identity_status",
        "signal_approval"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "EvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "record_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "mode": {
          "default": "FROZEN_SNAPSHOT",
          "enum": [
            "LIVE_REFERENCE",
            "FROZEN_SNAPSHOT"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "record_id"
      ],
      "title": "EvidenceSelection",
      "type": "object"
    },
    "EvidenceSnapshot": {
      "additionalProperties": false,
      "description": "Allowlisted canonical facts, never raw vendor payloads or source URLs.",
      "properties": {
        "label": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability": {
          "default": "UNKNOWN",
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "UNKNOWN"
          ],
          "title": "Availability",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "EvidenceSnapshot",
      "type": "object"
    },
    "ExistingWorkOrderReference": {
      "additionalProperties": false,
      "properties": {
        "canonical_asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Asset Id",
          "type": "string"
        },
        "canonical_record_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Record Id",
          "type": "string"
        },
        "record_status": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Status"
        },
        "work_type": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Type"
        },
        "source_changed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Changed At"
        },
        "collected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "projected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projected At"
        },
        "sources": {
          "$ref": "#/$defs/MaintenanceSources"
        },
        "informational_only": {
          "const": true,
          "default": true,
          "title": "Informational Only",
          "type": "boolean"
        },
        "interpretation": {
          "const": "SOURCE_FACT",
          "default": "SOURCE_FACT",
          "title": "Interpretation",
          "type": "string"
        },
        "freshness": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Freshness",
          "type": "string"
        }
      },
      "required": [
        "canonical_asset_id",
        "canonical_record_id",
        "sources"
      ],
      "title": "ExistingWorkOrderReference",
      "type": "object"
    },
    "FollowUpStatus": {
      "enum": [
        "PROPOSED",
        "PLANNED",
        "IN_PROGRESS",
        "COMPLETED",
        "CANCELLED"
      ],
      "title": "FollowUpStatus",
      "type": "string"
    },
    "MaintenanceSources": {
      "additionalProperties": false,
      "properties": {
        "maximo": {
          "$ref": "#/$defs/MaximoWorkOrderIdentity"
        }
      },
      "required": [
        "maximo"
      ],
      "title": "MaintenanceSources",
      "type": "object"
    },
    "MaximoWorkOrderIdentity": {
      "additionalProperties": false,
      "properties": {
        "source_object": {
          "const": "MXWODETAIL",
          "default": "MXWODETAIL",
          "title": "Source Object",
          "type": "string"
        },
        "source_record_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Record Ref",
          "type": "string"
        },
        "site": {
          "const": "BSR",
          "default": "BSR",
          "title": "Site",
          "type": "string"
        },
        "organization": {
          "const": "IP",
          "default": "IP",
          "title": "Organization",
          "type": "string"
        }
      },
      "required": [
        "source_record_ref"
      ],
      "title": "MaximoWorkOrderIdentity",
      "type": "object"
    },
    "PiAttributeLineage": {
      "additionalProperties": false,
      "properties": {
        "pi_source_id": {
          "const": "CENTRAL_PI",
          "title": "Pi Source Id",
          "type": "string"
        },
        "af_server_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Server Ref",
          "type": "string"
        },
        "af_database_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Database Ref",
          "type": "string"
        },
        "af_element_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Af Element Ref",
          "type": "string"
        },
        "mapping_role": {
          "const": "PRIMARY_EQUIPMENT",
          "title": "Mapping Role",
          "type": "string"
        },
        "mapping_status": {
          "const": "VERIFIED",
          "title": "Mapping Status",
          "type": "string"
        },
        "attribute_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Attribute Ref",
          "type": "string"
        },
        "attribute_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute Name"
        }
      },
      "required": [
        "pi_source_id",
        "af_server_ref",
        "af_database_ref",
        "af_element_ref",
        "mapping_role",
        "mapping_status",
        "attribute_ref"
      ],
      "title": "PiAttributeLineage",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "decision",
        "rationale",
        "decided_at"
      ],
      "title": "ReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "record_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CaseStatus",
      "default": "DRAFT"
    },
    "created_by": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "contributors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Contributors",
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_scope": {
      "const": "NADI_RECORD_REVIEW_ONLY",
      "default": "NADI_RECORD_REVIEW_ONLY",
      "title": "Approval Scope",
      "type": "string"
    },
    "canonical_asset_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Canonical Asset Id",
      "type": "string"
    },
    "case_ref": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Case Ref",
      "type": "string"
    },
    "evidence_selections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceSelection"
      },
      "maxItems": 20,
      "title": "Evidence Selections",
      "type": "array"
    },
    "rationale": {
      "maxLength": 6000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "proposed_action": {
      "maxLength": 6000,
      "minLength": 1,
      "title": "Proposed Action",
      "type": "string"
    },
    "priority": {
      "$ref": "#/$defs/Priority",
      "default": "NORMAL"
    },
    "responsible_team_ref": {
      "anyOf": [
        {
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:@-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Responsible Team Ref"
    },
    "responsible_person_ref": {
      "anyOf": [
        {
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:@-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Responsible Person Ref"
    },
    "target_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Date"
    },
    "existing_work_order_ref": {
      "anyOf": [
        {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Existing Work Order Ref"
    },
    "supporting_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "maxItems": 20,
      "title": "Supporting Evidence",
      "type": "array"
    },
    "existing_work_order": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingWorkOrderReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "follow_up_status": {
      "$ref": "#/$defs/FollowUpStatus",
      "default": "PROPOSED"
    },
    "provenance": {
