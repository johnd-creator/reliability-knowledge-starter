{
  "$defs": {
    "CaptureClock": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "role": {
          "default": "UNSPECIFIED",
          "enum": [
            "ACQUISITION",
            "SAMPLE",
            "ANALYSIS",
            "REPORT",
            "UNSPECIFIED"
          ],
          "title": "Role",
          "type": "string"
        },
        "precision": {
          "default": "UNKNOWN",
          "enum": [
            "DATE",
            "DATETIME",
            "LOCAL_DATETIME",
            "TIME",
            "RAW",
            "UNKNOWN"
          ],
          "title": "Precision",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "source_label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        }
      },
      "title": "CaptureClock",
      "type": "object"
    },
    "CaptureContext": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "role": {
          "enum": [
            "ACQUISITION",
            "OPERATING_CONTEXT",
            "LAB",
            "INSTRUMENT",
            "PROCEDURE",
            "CAMERA",
            "SAMPLE",
            "REPORT"
          ],
          "title": "Role",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "role",
        "label"
      ],
      "title": "CaptureContext",
      "type": "object"
    },
    "CaptureRow": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "row_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Row Id",
          "type": "string"
        },
        "source_label": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "title": "Source Label",
          "type": "string"
        },
        "source_field_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field Id"
        },
        "value_region": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}(?::\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Region"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "source_point": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Point"
        },
        "source_axis": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Axis"
        },
        "header_cells": {
          "default": [],
          "items": {
            "maxLength": 40,
            "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}(?::\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6})?$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Header Cells",
          "type": "array"
        },
        "value_origin": {
          "default": "UNKNOWN",
          "enum": [
            "SOURCE_LITERAL",
            "SOURCE_FORMULA_RESULT",
            "MANUAL_REPORTED",
            "UNKNOWN"
          ],
          "title": "Value Origin",
          "type": "string"
        },
        "row_role": {
          "default": "INPUT",
          "enum": [
            "INPUT",
            "REFERENCE",
            "SOURCE_ASSESSMENT"
          ],
          "title": "Row Role",
          "type": "string"
        },
        "contexts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CaptureContext"
          },
          "maxItems": 20,
          "title": "Contexts",
          "type": "array"
        },
        "clock": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureClock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "row_id",
        "source_label"
      ],
      "title": "CaptureRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "purpose": {
      "const": "PROVISIONAL_INPUT_ONLY",
      "default": "PROVISIONAL_INPUT_ONLY",
      "title": "Purpose",
      "type": "string"
    },
    "source_ref": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Source Ref",
      "type": "string"
    },
    "source_asset_label": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Asset Label"
    },
    "source_sheet_label": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sheet Label"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "sheet_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sheet Index"
    },
    "profile_id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "title": "Profile Version",
      "type": "string"
    },
    "clocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CaptureClock"
      },
      "maxItems": 12,
      "title": "Clocks",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/CaptureRow"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    }
  },
  "required": [
    "source_ref",
    "profile_id",
    "profile_version",
    "rows"
  ],
  "title": "InputCapture",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadi.example/schema/pdm-input-capture/v1.0",
  "description": "Typed provisional input only; source labels, values, lineage and temporal precision confer no engineering approval."
}
