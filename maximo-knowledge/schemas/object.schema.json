{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maximo-knowledge/schemas/object.schema.json",
  "title": "Maximo Object Structure Knowledge",
  "description": "Per-object knowledge record produced by OSLC discovery. Read by humans and AI tools (Codex/GLM) to build read-only data fetcher applications.",
  "type": "object",
  "required": ["system", "object_structure", "resource", "status"],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "string",
      "const": "maximo"
    },
    "object_structure": {
      "type": "string",
      "description": "Maximo integration object structure name, e.g. MXASSET, MXWODETAIL"
    },
    "resource": {
      "type": "string",
      "description": "Normalized reliability resource, e.g. asset, workorder"
    },
    "status": {
      "enum": ["unknown", "documented", "verified", "forbidden", "deprecated"]
    },
    "access": {
      "type": "string",
      "description": "Observed access result, e.g. http_200, http_403, unknown"
    },
    "endpoint": {
      "type": "string",
      "description": "Canonical OSLC query endpoint for this object structure"
    },
    "primary_key": {
      "description": "Verified primary-key field or bounded candidate evidence.",
      "oneOf": [
        {"type": ["string", "null"]},
        {
          "type": "object",
          "required": ["field", "confidence"],
          "additionalProperties": false,
          "properties": {
            "field": {"type": "string"},
            "confidence": {"enum": ["VERIFIED", "CANDIDATE", "UNKNOWN"]}
          }
        },
        {
          "type": "object",
          "required": ["preferred", "candidates", "excluded"],
          "additionalProperties": false,
          "properties": {
            "preferred": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/keyCandidate"}
              ]
            },
            "candidates": {
              "type": "array",
              "items": {"$ref": "#/$defs/keyCandidate"}
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "role", "reason"],
                "additionalProperties": false,
                "properties": {
                  "field": {"type": "string"},
                  "role": {"type": "string"},
                  "reason": {"type": "string"}
                }
              }
            }
          }
        }
      ]
    },
    "field_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Heuristic identifier-like field names (candidates for PK/filters)"
    },
    "important_fields": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Business field names observed on a minimal sample"
    },
    "field_types": {
      "type": "object",
      "additionalProperties": {"enum": ["string", "integer", "number", "boolean", "datetime", "object/reference", "collection-reference", "unknown"]},
      "description": "Lightweight primitive/reference types inferred from one bounded record"
    },
    "metadata_fields": {
      "type": "array",
      "items": {"type": "string"},
      "description": "OSLC/RDF/internal field names retained as structure only"
    },
    "field_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"enum": ["IDENTIFIER_CANDIDATE", "SCOPE_SITE", "SCOPE_ORGANIZATION", "ASSET_REFERENCE", "LOCATION_REFERENCE", "WORKORDER_REFERENCE", "PARENT_REFERENCE", "STATUS", "TIMESTAMP", "COLLECTION_REFERENCE", "FAILURE_REFERENCE", "INSPECTION_REFERENCE", "BUSINESS_ATTRIBUTE", "UNKNOWN"]}
      },
      "description": "Bounded semantic roles inferred from observed field names"
    },
    "role_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "roles", "evidence"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string"},
          "roles": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "string"}
        }
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "total_count": {"type": ["integer", "null"]},
        "next_page": {"type": "boolean"},
        "prev_page": {"type": "boolean"},
        "method": {"type": "string", "description": "How pagination is performed (curated, e.g. 'oslc.paging + pageno + oslc.pageSize')."},
        "single_record_via": {"type": "string", "description": "How a single record is fetched (curated, e.g. 'resource href')."}
      },
      "additionalProperties": false
    },
    "sample": {
      "description": "Sanitized single record sample. Sensitive/personal fields are redacted or removed."
    },
    "use_cases": {
      "type": "array",
      "items": {"type": "string"}
    },
    "relationships": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Verified relationships to other object structures"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {"type": "string"},
        "value": {"type": "string"},
        "status": {"enum": ["VERIFIED", "PRIOR_LIVE_QUERY", "UNKNOWN"]},
        "evidence": {"type": "string"}
      }
    },
    "detail_dereference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempted": {"type": "boolean"},
        "collection_records": {"type": "integer", "minimum": 0, "maximum": 1},
        "detail_records": {"type": "integer", "minimum": 0, "maximum": 1},
        "maximum_dereference_depth": {"const": 1},
        "pagination_followed": {"const": false},
        "resource_path": {"type": "string"},
        "http_status": {"type": "integer"},
        "status": {"enum": ["VERIFIED", "UNKNOWN", "BLOCKED", "INLINE_BUSINESS_RECORD"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "field_types": {"$ref": "#/$defs/fieldTypes"},
        "metadata_fields": {"type": "array", "items": {"type": "string"}},
        "query_shape_attempts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string"}, "endpoint": {"type": "string"}, "evidence": {"type": "string"}, "result": {"type": "string"}}}},
        "response_cap": {"type": "boolean"},
        "error": {"type": "object", "additionalProperties": true}
      }
    },
    "http_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http_status": {"type": "integer"},
        "maximo_error_code": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "raw_response_saved": {"const": false}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verified_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "catalog_source": {
      "enum": ["oslc-catalog", "seed-fallback", "oas-documented"],
      "description": "Origin of the catalog entry: live OSLC catalog, documented seed fallback, or OAS-documented (object present in the authenticated OAS but not OSLC-queryable by this account)."
    },
    "data_scope": {
      "type": "string",
      "description": "Organizational scope of the observed data, e.g. 'BSR (org IP)'."
    }
  },
  "$defs": {
    "fieldTypes": {
      "type": "object",
      "additionalProperties": {"enum": ["string", "integer", "number", "boolean", "datetime", "object/reference", "collection-reference", "unknown"]}
    },
    "keyCandidate": {
      "type": "object",
      "required": ["field", "confidence", "reason"],
      "additionalProperties": false,
      "properties": {
        "field": {"type": "string"},
        "confidence": {"enum": ["VERIFIED", "CANDIDATE", "UNKNOWN"]},
        "reason": {"type": "string"}
      }
    }
  }
}
