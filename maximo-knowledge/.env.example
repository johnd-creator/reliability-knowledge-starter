MAXIMO_BASE_URL=http://maximo.plnindonesiapower.co.id/maximo
MAXIMO_OAS_PATH=/oslc/oas
# Browser redirect observed after an unauthenticated request; this is not a
# POST target. The form client always uses the fixed /j_security_check path.
MAXIMO_LOGIN_PATH=/webclient/login/login.jsp?appservauth=true

# Business resources are GET/HEAD/OPTIONS-only. Form/login mode may submit one
# controlled authentication POST to the exact /j_security_check endpoint.
# Use a dedicated read-only account or a read-only bearer token.
MAXIMO_AUTH_MODE=bearer
MAXIMO_TOKEN=<READ_ONLY_BEARER_TOKEN>

# Form/login credentials are runtime-only and are sent only in that login body.
MAXIMO_USERNAME=<READ_ONLY_USERNAME>
MAXIMO_PASSWORD=<READ_ONLY_PASSWORD>

MAXIMO_TIMEOUT_SECONDS=30
MAXIMO_RATE_LIMIT_SECONDS=1
MAXIMO_MAX_RESPONSE_BYTES=1048576
