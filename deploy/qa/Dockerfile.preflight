# Source-free readiness image only; not an Engineering activation image.
FROM python:3.12-slim
ARG NADI_RELEASE_SHA
LABEL org.opencontainers.image.revision=$NADI_RELEASE_SHA
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY reliability-cockpit/pyproject.toml ./
COPY reliability-cockpit/src ./src
COPY reliability-cockpit/application-migrations ./application-migrations
COPY --chown=10001:10001 deploy/qa/.qa-release.json ./.qa-release.json
RUN pip install --no-cache-dir . && addgroup --gid 10001 app && adduser --uid 10001 --gid 10001 --disabled-password --gecos "" app
USER 10001:10001
ENTRYPOINT ["python", "-m", "src.qa.preflight"]
# Pass --release-manifest /app/.qa-release.json with the private config.
# Image digest/provenance and activation still require accountable approval.
