# Copy to .env.platform and replace all values. Do not commit the resulting file.
MAXIMO_DB_PASSWORD=change-me
PI_DB_PASSWORD=change-me
CEMS_DB_PASSWORD=change-me
COCKPIT_DB_PASSWORD=change-me

# Managed-collector mode only. Source credentials belong only to their respective
# collector container, never to Cockpit/web. Choose one Maximo auth mode.
MAXIMO_BASE_URL=https://maximo.example.invalid/maximo
MAXIMO_AUTH_MODE=login
MAXIMO_USERNAME=
MAXIMO_PASSWORD=
MAXIMO_READ_ONLY_TOKEN=
MAXIMO_SESSION_COOKIE=
# Managed PI: this file is the only configuration authority; no collector/home dotenv.
PI_WEB_API_BASE_URL=https://pi.example.invalid/piwebapi
PI_USERNAME=
PI_PASSWORD=
# Optional compatibility Bearer token; Basic remains the verified instance mode.
PI_TOKEN=
PI_TIMEOUT_SECONDS=30
# Source client enforces >=1s/request and <=1MiB even if configured otherwise.
PI_RATE_LIMIT_SECONDS=1.0
PI_MAX_RESPONSE_BYTES=1048576
PI_VERIFY_TLS=1
CEMS_MODBUS_HOST=192.0.2.10
CEMS_MODBUS_PORT=502

# External-collector mode. Point these to existing APIs; for collectors on the
# Linux host from a Cockpit container, use host.docker.internal as below.
MAXIMO_COLLECTOR_API_BASE=http://host.docker.internal:8002
PI_COLLECTOR_API_BASE=http://host.docker.internal:8001
CEMS_COLLECTOR_API_BASE=http://host.docker.internal:8003

# Runtime settings (seconds). Tune after capacity testing.
MAXIMO_OPERATIONAL_INTERVAL_SECONDS=300
MAXIMO_ASSET_INTERVAL_SECONDS=21600
# Legacy name retained: pause AFTER each completed snapshot cycle, not a
# fixed-rate cycle start. Measured 508s acquisition + 300s pause = ~808s (~13.5m).
# CLI --pause-seconds is preferred; --interval-seconds remains an alias.
# Worker and API schedule metadata receive the same non-secret pause value.
PI_SNAPSHOT_INTERVAL_SECONDS=300
# Recorded/history jobs are separately governed; not enabled by snapshot worker.
PI_RECORDED_INTERVAL_SECONDS=300
CEMS_AGGREGATION_INTERVAL_SECONDS=300
COCKPIT_SYNC_INTERVAL_SECONDS=300

# Existing Reliability Mart in maximo-db/maximo_collector; NEVER legacy cockpit.
# API is SELECT-only. Admin/writer DSN is scoped to local maintenance/projector.
# Populate private credentials after deliberate `cockpit mart-reader --apply`.
RELIABILITY_MART_DATABASE_URL=postgresql+psycopg://nadi_mart_reader:change-me@maximo-db/maximo_collector
RELIABILITY_MART_ADMIN_DATABASE_URL=postgresql+psycopg://maximo_collector:change-me@maximo-db/maximo_collector
RELIABILITY_MART_EXPECT_DATABASE=maximo_collector
RELIABILITY_MART_READER_PASSWORD=
MART_PROJECTION_INTERVAL_SECONDS=300
# External mode MUST replace the reader DSN host with the reachable existing Mart;
# it does not run Mart initialization/projectors or create a Mart DB.
