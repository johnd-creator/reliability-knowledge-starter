# Copy to .env.platform and replace all values. Do not commit the resulting file.
MAXIMO_DB_PASSWORD=change-me
PI_DB_PASSWORD=change-me
CEMS_DB_PASSWORD=change-me
COCKPIT_DB_PASSWORD=change-me

# Managed-collector mode only. Source credentials belong only to their respective
# collector container, never to Cockpit/web. Choose one Maximo auth mode.
MAXIMO_BASE_URL=https://maximo.example.invalid/maximo
MAXIMO_AUTH_MODE=login
MAXIMO_USERNAME=
MAXIMO_PASSWORD=
MAXIMO_READ_ONLY_TOKEN=
MAXIMO_SESSION_COOKIE=
PI_WEB_API_BASE_URL=https://pi.example.invalid/piwebapi
PI_USERNAME=
PI_PASSWORD=
CEMS_MODBUS_HOST=192.0.2.10
CEMS_MODBUS_PORT=502

# External-collector mode. Point these to existing APIs; for collectors on the
# Linux host from a Cockpit container, use host.docker.internal as below.
MAXIMO_COLLECTOR_API_BASE=http://host.docker.internal:8002
PI_COLLECTOR_API_BASE=http://host.docker.internal:8001
CEMS_COLLECTOR_API_BASE=http://host.docker.internal:8003

# Runtime cadence (seconds). Tune after capacity testing.
MAXIMO_OPERATIONAL_INTERVAL_SECONDS=300
MAXIMO_ASSET_INTERVAL_SECONDS=21600
PI_SNAPSHOT_INTERVAL_SECONDS=60
PI_RECORDED_INTERVAL_SECONDS=300
CEMS_AGGREGATION_INTERVAL_SECONDS=300
COCKPIT_SYNC_INTERVAL_SECONDS=300
