# --- Maximo (site BSR, org IP) ---
MAXIMO_BASE_URL=http://maximo.plnindonesiapower.co.id/maximo
MAXIMO_OSLC_ROOT=/oslc/os
MAXIMO_SITE_ID=BSR
MAXIMO_ORG_ID=IP

# Auto-login (programmatic login per maximo-knowledge/docs/authentication.md).
# POST /j_security_check ONCE per session, then GET-only OSLC requests.
# Use a dedicated READ-ONLY account.
MAXIMO_USERNAME=<READ_ONLY_USERNAME>
MAXIMO_PASSWORD=<READ_ONLY_PASSWORD>

# Alternatives (no login round-trip) if an admin issues them:
# MAXIMO_AUTH_MODE=login|token|cookie
MAXIMO_AUTH_MODE=login
MAXIMO_READ_ONLY_TOKEN=
# Optional out-of-band session cookie (runtime only; never commit it).
MAXIMO_SESSION_COOKIE=

# Safety guardrails (mirror maximo-knowledge discovery rules)
MAXIMO_TIMEOUT_SECONDS=30
MAXIMO_RATE_LIMIT_SECONDS=1.0
MAXIMO_PAGE_SIZE=100
MAXIMO_MAX_RESPONSE_BYTES=1048576

# --- Collector local store (Postgres) ---
DATABASE_URL=postgresql+psycopg://mxcollector:mxcollector@localhost:5434/mxcollector
DATABASE_ECHO=0

# --- API ---
API_HOST=127.0.0.1
API_PORT=8002
