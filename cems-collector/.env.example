# --- CEMS Modbus source (Beijer Box2Base gateway, read-only polling) ---
CEMS_MODBUS_HOST=172.16.201.132
CEMS_MODBUS_PORT=502
CEMS_MODBUS_UNIT_ID=1
CEMS_MODBUS_TIMEOUT_SECONDS=3
CEMS_MODBUS_RETRY_ATTEMPTS=3
CEMS_MODBUS_RETRY_DELAY_SECONDS=5

# Safety guardrails (floors enforced in CemsConfig.validate_runtime_safety)
# Minimum pause between two Modbus transactions (seconds).
CEMS_MIN_REQUEST_GAP_SECONDS=0.05
# Protocol maximum is 125 registers per read; never raise above it.
CEMS_MAX_REGISTERS_PER_READ=125

# --- Collection ---
# Single-stack scope: only this stack_id is collected and served.
CEMS_STACK_ID=1
CEMS_POLL_INTERVAL_SECONDS=5
# Registry file (stacks + parameters + modbus config, quarantined from contracts)
CEMS_PARAMETER_REGISTRY=registry/cems-parameters.yaml
# Re-read the parameter registry from the local store every N seconds.
CEMS_PARAMETER_REFRESH_SECONDS=60

# --- Aggregation ---
CEMS_AGGREGATION_INTERVAL_MINUTES=5

# --- Collector local store (Postgres) ---
DATABASE_URL=postgresql+psycopg://cemscollector:cemscollector@localhost:5435/cemscollector
DATABASE_ECHO=0

# --- API ---
API_HOST=127.0.0.1
API_PORT=8003
